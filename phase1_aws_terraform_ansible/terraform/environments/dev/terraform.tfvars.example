# Copy to terraform.tfvars and edit. terraform.tfvars is git-ignored.

aws_region   = "us-east-1"
project_name = "iotbtech-phase1"
environment  = "dev"

# REQUIRED: your own public IP with /32  (find it: curl -s https://checkip.amazonaws.com)
#allowed_ssh_cidrs = ["203.0.113.10/32"]

# Public half of the key you created with ssh-keygen
public_key_path = "~/.ssh/iotbtech-aws.pub"

instance_type    = "t3.micro"
root_volume_size = 20
